---
import "../assets/styles.css";
import DATA from "../data/data";
import Navbar from "../components/ui/navbar/Navbar.astro";
import Footer from "../components/ui/navbar/Footer.astro";
---
<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>{DATA.name}</title>
	</head>
	<body class="w-screen max-w-screen">
		<div class="w-screen max-w-screen h-full bg-base-300 overflow-x-clip object-scale-down">
		<Navbar />
		<slot />
		<Footer />
		</div>
	</body>
</html>


