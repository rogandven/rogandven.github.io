---
import type EventClass from '../../../classes/EventClass';
import DUCertificateCollapse from '../certificates/DUCertificateCollapse.astro';

interface Props {
    DATA: any,
    _class?: string,
}

const { 
    DATA,
    _class = "",
} = Astro.props;
---
<h1 class="text-4xl font-extrabold">Certificaciones</h1>

<div class={_class}>
    {DATA.certifications.map((certification: EventClass, index: number) => {
        return (<DUCertificateCollapse certificate={certification} _id={index} />)
    })}
</div>