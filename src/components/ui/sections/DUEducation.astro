---
import DUTimeline from '../education/DUTimeline.astro';

interface Props {
    DATA: any,
    _class?: string,
}

const { 
    DATA,
    _class = "",
} = Astro.props;
---
<div class="text-4xl font-extrabold">Educación</div>

<div class={_class}>
    <DUTimeline eventList={DATA.education} />
</div>