---
import type EventClass from '../../../classes/EventClass';
import DUTimeline from '../education/DUTimeline.astro';
import { getPrintableTimePeriod, hasURL } from "../../../utils/general.utils";
import Picture from 'astro/components/Picture.astro';
import InvisibleEvent from '../other/InvisibleEvent.astro';
import Title from '../other/Title.astro';

interface Props {
    DATA: any,
    _class?: string,
}

const { 
    DATA,
    _class = "",
} = Astro.props;
---
<Title text={"Educación"} />

<div class="hidden size-0">
    {DATA.education.map((school: EventClass) => {
        return <InvisibleEvent school={school} shallDisplayPresent={true} />
    })}
</div>

<aside>
<div class={_class}>
    <DUTimeline eventList={DATA.education} _class={_class} />
</div>
</aside>