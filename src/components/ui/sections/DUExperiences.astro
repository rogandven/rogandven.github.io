---
import type EventClass from '../../../classes/EventClass';
import DUCard from '../experience/DUCard.astro';
import InvisibleEvent from '../other/InvisibleEvent.astro';
import Title from '../other/Title.astro';

interface Props {
    DATA: any,
    _class?: string,
}

const { 
    DATA,
    _class = "",
} = Astro.props;
---
<Title text={"Experiencia"} />

<div class="hidden size-0">
    {DATA.experience.map((experience: EventClass) => {
        return <InvisibleEvent school={experience} shallDisplayPresent={false} />
    })}
</div>

<aside>
<div class={_class}>
    {DATA.experience.map((event: EventClass, index: number) => {
            return (<DUCard _class={"mt-2 mb-2"} event={event} _id={"experience" + index} isLeftCard={(index % 2) === 0} shallDisplayPresent={false} />)
    })}  
</div>
</aside> 