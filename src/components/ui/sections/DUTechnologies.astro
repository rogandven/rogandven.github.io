---
import DUTechnologyCard from '../technologies/DUTechnologyCard.astro';
import { DAISYUI_TEXT_COLORS } from '../../../constants/daisyui.constants';
import { DAISYUI_PROGRESS_COLORS } from '../../../constants/daisyui.constants';
import type Tool from '../../../classes/Tool';

interface Props {
    DATA: any,
    _class?: string,
}

const { 
    DATA,
    _class = ""
} = Astro.props;
---

<div class="text-4xl font-extrabold">Habilidades Técnicas</div>
<div class={_class}>
    <div class="flex flex-row flex-wrap">
        {DATA.tools.map((tool: Tool, index: number) => {
            return <DUTechnologyCard 
                tool={tool} 
                text_color={DAISYUI_TEXT_COLORS[index % DAISYUI_TEXT_COLORS.length]}
                proficiency_color={DAISYUI_PROGRESS_COLORS[index % DAISYUI_TEXT_COLORS.length]}
            />
        })}
    </div>
</div>