---
import { Icon } from 'astro-icon/components';
import type HeadingTitle from '../../../classes/HeadingTitle';

interface Props {
    title: HeadingTitle,
    _class?: string
}

const { 
  title,
  _class = "",
} = Astro.props;
---
<div class="w-full">
  <div class="w-fit ml-auto mr-auto">
    <h2 id={title.sluggifiedTitle} class=`text-4xl font-extrabold ${_class} flex flex-row items-center`>
        <aside><Icon name={title.iconName} class="mr-1 w-fit" /></aside>
        {title.normalTitle}
    </h2>
  </div>
</div>
