---
import type HeadingTitle from '../../../classes/HeadingTitle';
import { slugify } from '../../../utils/general.utils';

interface Props {
    title: HeadingTitle,
    _class?: string
}

const { 
  title,
  _class = "",
} = Astro.props;
---
<h2 id={title.sluggifiedTitle} class=`text-4xl font-extrabold w-full ${_class} text-center`>{title.normalTitle}</h2>
