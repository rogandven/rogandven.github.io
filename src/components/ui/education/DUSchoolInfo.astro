---
import { Icon } from "astro-icon/components";
import { DAISYUI_BADGE_COLORS, DIVIDER } from "../../../constants/daisyui.constants";
import { MESES_ESPANIOL } from "../../../constants/general.constants";
import DUTooltip from "../../../components/ui/profilecard/DUTooltip.astro";
import DUBadge from "../../../components/ui/profilecard/DUBadge.astro";
import PictureAstroComponent from "astro/components/Picture.astro";
import EventClass from "../../../classes/EventClass";
import DUSchoolInfoLink from "./DUSchoolInfoLink.astro";
import DUNameAndOrganization from "./DUNameAndOrganization.astro";

interface Props {
    school?: EventClass | undefined;
    _id: number;
}

const { 
    school = undefined,
    _id = 0
} = Astro.props;

---
{school !== undefined ? (
    <div>
        <form method="dialog">
            <button 
                class="btn btn-sm btn-circle btn-error text-lg absolute right-2 top-2" 
                aria-label="Cerrar"
            >
                <Icon name="mdi:close" />
            </button>
        </form>

        <DUNameAndOrganization school={school} id={_id} shallShowLocation={true}  />

        <DUTooltip text={"Tiempo"}>
            <p class="text-sm flex flex-row align-middle items-center">
                <span class="text-secondary flex flex-row align-middle items-center">
                    <Icon name="mdi:clock" class="mr-1" /> 
                    {MESES_ESPANIOL[school.startDate.getMonth()] + " " + school.startDate.getFullYear()}
                    <Icon name="mdi:arrow-right" class="mr-1 ml-1"></Icon>
                    {(school.endDate && (
                        MESES_ESPANIOL[school.endDate.getMonth()] + " " + school.endDate.getFullYear()
                    )) || "Presente"}
                </span>
            </p>    
        </DUTooltip>

        {school.description ? (
            <p class="mt-2 mb-2">{school.description}</p>
        ) : (
            <p class="opacity-50 italic mt-2 mb-2">Descripción no disponible</p>
        )}

        {school.imageURL ? (
            <div>
            <DUTooltip text={`${school.companyName}: ${school.name}`}>
                <PictureAstroComponent
                    class="rounded-lg"
                    src={school.imageURL} 
                    format="avif" 
                    width={640} 
                    height={360}
                    alt={school.companyName + ": " + school.name}
                />
            </DUTooltip>
            {school.isImageReferential && 
                <p class="text-xs italic opacity-50">Imagen es únicamente referencial</p>
            }
            </div>
        ) : ("")}

        <div class="flex flex-row flex-wrap mb-2">
            {school.relevantCourses.map((course, index) => {
                return (
                    <div class="m-0.5">
                    <DUTooltip text={String(course).toUpperCase()}>
                    <DUBadge 
                        color={DAISYUI_BADGE_COLORS[index % DAISYUI_BADGE_COLORS.length]}
                        content={course}
                        iconName="mdi:class"
                        textId="0"
                        isSmall={true}
                    />
                    </DUTooltip>
                    </div>
                )
            })}
        </div>

        {school.websiteURL && <DUSchoolInfoLink 
            link={school.websiteURL}
            linkName={"Link de la Organización"}
        />}
        {school.repositoryURL && <DUSchoolInfoLink 
            link={school.repositoryURL}
            linkName={"Link del Repositorio"}
        />} 
        {school.certificateURL && <DUSchoolInfoLink 
            link={school.certificateURL}
            linkName={"Link del Certificado"}
        />}                  
    </div>
) : ("")}