---
import { Icon } from "astro-icon/components";
import { MESES_ESPANIOL } from "../../../constants/general.constants";
import EventClass from "../../../classes/EventClass";

interface Props {
    school: EventClass
    shallDisplayPresent: boolean
};

const school = Astro?.props?.school;
const shallDisplayPresent = Astro?.props?.shallDisplayPresent;

/* const { 
    school,
    shallDisplayPresent,
} = Astro.props; */

const ArrowRight = (<Icon name="mdi:arrow-right" class="mr-1 ml-1" />);

---
<div>{
    (school.endDate && 
        <div><ArrowRight />{MESES_ESPANIOL[school.endDate.getMonth()] + " " + school.endDate.getFullYear()}</div>
    ) || (shallDisplayPresent && 
        <div><ArrowRight />{"Presente"}</div>
    ) || <div></div>
}</div>