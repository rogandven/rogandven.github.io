---
import { Icon } from "astro-icon/components";
import { MESES_ESPANIOL } from "../../../constants/general.constants";
import EventClass from "../../../classes/EventClass";
import DUArrowRight from "./DUArrowRight.astro";

interface Props {
    school: EventClass
    shallDisplayPresent: boolean
};

const school = Astro?.props?.school;
const shallDisplayPresent = Astro?.props?.shallDisplayPresent;

/* const { 
    school,
    shallDisplayPresent,
} = Astro.props; */

// const ArrowRight = ();

---
<div>{
    (school.endDate && 
        <div><DUArrowRight />{MESES_ESPANIOL[school.endDate.getMonth()] + " " + school.endDate.getFullYear()}</div>
    ) || (shallDisplayPresent && 
        <div><DUArrowRight />{"Presente"}</div>
    ) || <div></div>
}</div>