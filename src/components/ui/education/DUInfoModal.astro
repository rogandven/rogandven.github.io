---
import { Icon } from 'astro-icon/components';
import EventClass from '../../../classes/EventClass';
import DUTooltip from '../profilecard/DUTooltip.astro';
import { DAISYUI_ROUNDED_BUTTON } from '../../../constants/daisyui.constants';
import DUExternalModal from './DUExternalModal.astro';

interface Props {
    id: string,
    event: EventClass,
    shallDisplayPresent: boolean,
    shallGenerateModal: boolean,
}

const { 
    id,
    event,
    shallDisplayPresent,
    shallGenerateModal,
} = Astro.props;
---
<DUTooltip text="Mostrar Más">
<button class={`btn-info ${DAISYUI_ROUNDED_BUTTON} text-3xl`} onclick=`{my_modal_${id}.showModal()}` aria-haspopup="menu" aria-label="Mostrar Más">
    <Icon class="overflow-visible" name="mdi:information-outline" />
</button>
</DUTooltip>

{ shallGenerateModal &&
  <DUExternalModal id={id} event={event} shallDisplayPresent={shallDisplayPresent} />
}
