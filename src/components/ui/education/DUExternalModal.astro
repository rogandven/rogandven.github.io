---
import DUSchoolInfo from "./DUSchoolInfo.astro";
import EventClass from "../../../classes/EventClass";

interface Props {
    id: string,
    event: EventClass,
    shallDisplayPresent: boolean,
}

const { 
    id,
    event,
    shallDisplayPresent,
} = Astro.props;
---
<dialog id={`my_modal_${id}`} class="modal">
  <div class="modal-box">
    <DUSchoolInfo school={event} _id={`my_modal_${id}`} shallDisplayPresent={shallDisplayPresent} aria-hidden="true"/>
  </div>
</dialog>