---
import Picture from 'astro/components/Picture.astro';
import EventClass from '../../../classes/EventClass';
import { cutOffText } from '../../../utils/general.utils';
import DUInfoModal from '../education/DUInfoModal.astro';
import { DEFAULT_IMAGE_URL } from '../../../constants/daisyui.constants';
import DUNameAndOrganization from '../education/DUNameAndOrganization.astro';
import DUTooltip from '../profilecard/DUTooltip.astro';

interface Props {
  event: EventClass,
  _id: string,
}

const { 
  event,
  _id,
} = Astro.props;
---
<div class="card card-side bg-base-100 shadow-sm w-150">
  <DUTooltip text={`${event.companyName}: ${event.name}`}>
  <figure>
      <Picture 
        src={event.imageURL || DEFAULT_IMAGE_URL} 
        alt={`${event.companyName}: ${event.name}`} 
        format="avif" 
        width="200" 
        height="280"
        class="h-full" 
      />
  </figure>
  </DUTooltip>
  <div class="card-body line-clamp-10">
    <DUNameAndOrganization school={event} shallShowLocation={false} />
    <p>{event.description && cutOffText(event.description, 100)}</p>
    <div class="card-actions justify-end mt-2">
      <DUInfoModal event={event} id={_id} />
    </div>
  </div>
</div>