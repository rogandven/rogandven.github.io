---
import DUNameAndOrganization from '../../education/DUNameAndOrganization.astro';
import { cutOffText } from '../../../../utils/general.utils';
import DUSchoolInfoLink from '../../education/DUSchoolInfoLink.astro';
import DUInfoModal from '../../education/DUInfoModal.astro';
import EventClass from '../../../../classes/EventClass';

interface Props {
    _id: string;
    event: EventClass;
    shallDisplayPresent: boolean;
}

const { 
    _id,
    event, 
    shallDisplayPresent,
} = Astro.props;
---
<div class="card-body line-clamp-10">
    <DUNameAndOrganization school={event} shallShowLocation={false} shallDisplayShortDate={false} />
    <p>{event.description && cutOffText(event.description, 100)}</p>
    {event.repositoryURL && 
        <p><DUSchoolInfoLink link={event.repositoryURL} linkName={"Link del Repositorio"} /></p>
    }
    {event.reportURL && 
        <p><DUSchoolInfoLink link={event.reportURL} linkName={"Link del Informe"} /></p>
    }    
    {event.websiteURL && 
        <p><DUSchoolInfoLink link={event.websiteURL} linkName={"Página Web"} /></p>
    }    
    <div class="card-actions justify-end mt-2">
        <DUInfoModal event={event} id={_id} shallDisplayPresent={shallDisplayPresent} />
    </div>
</div>