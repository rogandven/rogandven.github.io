---
import DUTooltip from "../../profilecard/DUTooltip.astro";
import Picture from "astro/components/Picture.astro";
import EventClass from "../../../../classes/EventClass";
import { DEFAULT_IMAGE_URL } from "../../../../constants/daisyui.constants";

interface Props {
    event: EventClass;
}

const { 
    event, 
} = Astro.props;
---

<DUTooltip text={`${event.name}`}>
<figure>
    <Picture 
    src={event.imageURL || DEFAULT_IMAGE_URL} 
    alt={`${event.name}`} 
    format="avif" 
    width="200" 
    height="280"
    class="h-full" 
    />
</figure>
</DUTooltip>